/* Template for build/link/sly2.ld, written by tools/link.py (docs/guides/full-link.md).
   SECTIONS below: one output section per allocated section of the ELF, at its address, holding the object sections
   placed there in address order and blobs cut from the ELF for every byte no object covers.
   After it: _gp from the ELF's .reginfo, tools/linkaliases.py's aliases, and the absolute addresses of names that
   only unbuilt code or data defines. */
ENTRY(_start)

SECTIONS
{
@SECTIONS@
  /* object sections the ELF has no place for: kept apart so they do not disturb the layout */
  .unplaced 0x10000000 : { *(.text .rodata .data .bss .sdata .sbss COMMON .gnu.linkonce.*) }
  /DISCARD/ : { *(.mdebug* .comment .note*) }
}

@SYMBOLS@
